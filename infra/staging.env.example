# Copy to an untracked secret file or configure these values in your hosting secret store.
# Never commit real credentials.
POSTGRES_DB=miran
POSTGRES_USER=miran
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_POOL_MAX=10
MARKETPLACE_API_PORT=3001

MIRAN_PUBLIC_URL=https://almiran.ir

# Zarinpal: keep Sandbox enabled until end-to-end staging verification is complete.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Private seller document bucket (must not be publicly readable).
MIRAN_OBJECT_STORAGE_ENDPOINT=
MIRAN_OBJECT_STORAGE_BUCKET=
MIRAN_OBJECT_STORAGE_REGION=auto
MIRAN_OBJECT_STORAGE_ACCESS_KEY_ID=
MIRAN_OBJECT_STORAGE_SECRET_ACCESS_KEY=
MIRAN_OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Public product/banner media bucket or S3-compatible origin + CDN/base URL.
MIRAN_PUBLIC_MEDIA_ENDPOINT=
MIRAN_PUBLIC_MEDIA_BUCKET=
MIRAN_PUBLIC_MEDIA_REGION=auto
MIRAN_PUBLIC_MEDIA_ACCESS_KEY_ID=
MIRAN_PUBLIC_MEDIA_SECRET_ACCESS_KEY=
MIRAN_PUBLIC_MEDIA_FORCE_PATH_STYLE=false
MIRAN_PUBLIC_MEDIA_BASE_URL=https://media.almiran.ir
