# Keep search-engine indexing disabled until the storefront is production-ready.
SITE_INDEXABLE=false

# Canonical public storefront and server-side API origins.
MIRAN_PUBLIC_URL=https://almiran.ir
API_BASE_URL=http://localhost:3001

# Payment credentials belong only in the deployment secret store.
# Never commit a real Merchant ID to the repository.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Private S3-compatible object storage for seller identity/business documents.
# The bucket must remain private. Values below are placeholders only.
MIRAN_OBJECT_STORAGE_ENDPOINT=
MIRAN_OBJECT_STORAGE_BUCKET=
MIRAN_OBJECT_STORAGE_REGION=auto
MIRAN_OBJECT_STORAGE_ACCESS_KEY_ID=
MIRAN_OBJECT_STORAGE_SECRET_ACCESS_KEY=
MIRAN_OBJECT_STORAGE_FORCE_PATH_STYLE=false
MIRAN_OBJECT_STORAGE_UPLOAD_EXPIRES_SECONDS=600
MIRAN_OBJECT_STORAGE_DOWNLOAD_EXPIRES_SECONDS=300
