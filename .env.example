# Keep search-engine indexing disabled until final production verification.
SITE_INDEXABLE=false

# Canonical public storefront.
MIRAN_PUBLIC_URL=https://almiran.ir

# PostgreSQL. Real production values belong in the protected deployment env file.
POSTGRES_DB=miran
POSTGRES_USER=miran
POSTGRES_PASSWORD=
DATABASE_POOL_MAX=10

# Redis is private to the Docker network but still requires authentication.
REDIS_PASSWORD=

# Caddy edge configuration. In production the defaults below enable automatic TLS.
MIRAN_SITE_ADDRESS=almiran.ir
MIRAN_WWW_SITE_ADDRESS=www.almiran.ir
MIRAN_CANONICAL_URL=https://almiran.ir
HTTP_PORT=80
HTTPS_PORT=443

# Internal API Gateway behaviour.
GATEWAY_AUTH_RATE_LIMIT_PER_MINUTE=30
GATEWAY_UPSTREAM_TIMEOUT_MS=30000

# Reservation/session cleanup executed inside catalog-service.
MIRAN_MAINTENANCE_INTERVAL_MS=60000

# Payment credentials belong only in the deployment secret store.
# Never commit a real Merchant ID to the repository.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Private S3-compatible object storage for seller identity/business documents.
# The bucket must remain private. Values below are placeholders only.
MIRAN_OBJECT_STORAGE_ENDPOINT=
MIRAN_OBJECT_STORAGE_BUCKET=
MIRAN_OBJECT_STORAGE_REGION=auto
MIRAN_OBJECT_STORAGE_ACCESS_KEY_ID=
MIRAN_OBJECT_STORAGE_SECRET_ACCESS_KEY=
MIRAN_OBJECT_STORAGE_FORCE_PATH_STYLE=false
MIRAN_OBJECT_STORAGE_UPLOAD_EXPIRES_SECONDS=600
MIRAN_OBJECT_STORAGE_DOWNLOAD_EXPIRES_SECONDS=300

# Public product media storage. Upload credentials remain secret; only the
# resulting verified media URL is public.
MIRAN_PUBLIC_MEDIA_ENDPOINT=
MIRAN_PUBLIC_MEDIA_BUCKET=
MIRAN_PUBLIC_MEDIA_REGION=auto
MIRAN_PUBLIC_MEDIA_ACCESS_KEY_ID=
MIRAN_PUBLIC_MEDIA_SECRET_ACCESS_KEY=
MIRAN_PUBLIC_MEDIA_FORCE_PATH_STYLE=false
MIRAN_PUBLIC_MEDIA_UPLOAD_EXPIRES_SECONDS=600
MIRAN_PUBLIC_MEDIA_BASE_URL=https://media.almiran.ir
